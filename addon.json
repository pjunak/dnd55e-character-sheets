{
  "$schema": "../ttrpg-codex/contracts/addons/v3/manifest.schema.json",
  "packageFormat": 1,
  "id": "dnd-sheets",
  "name": "D&D Character Sheets",
  "version": "3.0.0",
  "description": "Hand-fillable D&D character sheets with optional rules-engine guidance.",
  "license": "MIT",
  "compatibility": {
    "host": ">=2.0.0 <3.0.0",
    "addonApi": "^3.0.0"
  },
  "capabilities": {
    "required": ["ui.contributions"],
    "optional": []
  },
  "runtime": {
    "ui": {
      "mode": "integrated",
      "entry": "web/index.js",
      "styles": ["web/index.css"]
    }
  },
  "permissions": [],
  "contributions": [
    {
      "id": "sheet.section",
      "surface": "article-section",
      "label": "D&D Character Sheet",
      "roles": ["dm", "player"],
      "order": 100,
      "requires": ["ui.contributions"],
      "config": { "collection": "characters" }
    }
  ],
  "recordExtensions": [
    {
      "id": "dnd-sheets",
      "target": "characters",
      "visibility": "public",
      "schema": "contracts/sheet-state.schema.json",
      "schemaVersion": "3.0.0"
    }
  ],
  "services": {
    "consumes": [
      {
        "contract": "dnd5e.rules-engine",
        "range": "^3.0.0",
        "cardinality": "one",
        "required": false,
        "selection": "operator"
      }
    ]
  }
}
